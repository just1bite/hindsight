# LLM Provider (OpenAI-compatible)
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=***
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
HINDSIGHT_API_LLM_BASE_URL=https://api.openai.com/v1

# TokenHarbor example
# HINDSIGHT_API_LLM_BASE_URL=https://tokenharbor.ai/v1
# HINDSIGHT_API_LLM_MODEL=deepseek-v4.1-flash:free

# Auth (required for production)
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-to-secure-password
AUTH_SECRET_KEY=generate-64-char-random-hex
AUTH_API_KEY=generate-64-char-random-hex

# Optional: Control Plane access key (alternative to username/password)
# HINDSIGHT_CP_ACCESS_KEY=your-shared-secret
